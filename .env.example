# Salin file ini menjadi .env, lalu isi dengan nilai lokal kamu.
# .env sudah di-ignore git, jadi kredensial tidak ikut ter-commit.

# Kunci sesi Flask. Buat nilai acak yang panjang, misal:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Koneksi MySQL/MariaDB
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=bayarlistrik_db

# Endpoint /debug_login_admin hanya aktif kalau Flask jalan dengan
# debug=True DAN DEBUG_LOGIN_ENABLED=true. Biarkan false untuk produksi.
DEBUG_LOGIN_ENABLED=false
DEBUG_ADMIN_USER=
DEBUG_ADMIN_PASSWORD=
